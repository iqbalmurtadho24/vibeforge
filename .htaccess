# Apache Configuration - Vibeforge
# ================================================
# Place this file in the project root (outside public/)

# Disable directory listing
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block direct access to important directories
    # Note: core/ is allowed for the router proxy to function
    RewriteRule ^(include|modules|data|cache|migrations|docs)/ - [F,L]

    # 2. Redirect traffic to public/ folder
    # This makes the domain read from domain.com/public/
    # Required for shared hosting where document root cannot be set to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block access to sensitive files
<FilesMatch "\.(env|log|sql|md|json|key|pem)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block access to backup files
<FilesMatch "\.(bak|backup|old|orig|original|swp|swo)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block access to version control
<FilesMatch "^\.(git|svn|hg|gitignore|gitattributes)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block access to IDE files
<FilesMatch "^\.(idea|vscode|vs|settings)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
</IfModule>

# open_basedir hardening.
# NOTE: this path is environment-specific and MUST match the deploy location.
# <IfModule mod_php.c>
#     php_admin_value open_basedir "/home/USER/public_html:/tmp"
# </IfModule>
